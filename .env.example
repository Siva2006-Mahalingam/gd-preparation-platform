# ========================================
# GD PREPARATION PLATFORM — API CONFIG
# ========================================
# Copy this file to .env and fill in your values.
#
# HOW TO USE:
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your API URL and API Key below
# 3. Restart the server
# ========================================

# ----- Topic API -----
# Used to fetch GD topics when creating/joining rooms.
# The API should return a JSON response containing a topic string.
# Example: { "topic": "Should AI replace teachers?" }
TOPIC_API_URL=
TOPIC_API_KEY=

# ----- Evaluation API -----
# Used for AI-powered individual evaluation after a GD ends.
# This can be the same API or a different one.
# Example: OpenAI, Gemini, or any LLM API endpoint.
EVAL_API_URL=
EVAL_API_KEY=

# ----- JWT Secret -----
# Used for signing authentication tokens.
# Change this to a long random string in production.
JWT_SECRET=gd-platform-secret-change-me-in-production

# ----- Server Port -----
PORT=3000
